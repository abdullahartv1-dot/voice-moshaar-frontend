# Mostashar Voice — Frontend env vars
# Copy to .env.local for local development.

# Backend origin. Leave empty to use Vite's dev proxy (localhost:5173 → backend at port 8080 via SSH tunnel).
# For production builds, set this to the public origin of the backend, e.g. https://voice.api.example.com
# On Vercel: configure as a Project Environment Variable (Settings → Environment Variables).
VITE_BACKEND_URL=

# API key sent as `xi-api-key` header. Must match MV_API_KEY env var on the backend.
# Leave empty if backend has auth disabled (development).
VITE_API_KEY=mostashar-dev-key

# ----- Moshaar MCP defaults (overridable per-user in the Settings page) -----
# Default Moshaar MCP endpoint. Users can override via Settings → MCP.
VITE_DEFAULT_MCP_URL=https://api.moshaar.com/v2/mcp/master

# Whether to allow MCP-free chat mode (true → if user hasn't set MCP key,
# voice agent still works but can't manage Moshaar). false → require MCP key
# before allowing /call.
VITE_REQUIRE_MCP=false
